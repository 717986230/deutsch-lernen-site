{"zh":[{"start":2.99,"end":8.23,"text":"怎样安全地观看日全食"},{"start":8.25,"end":12.37,"text":"如果你在全食带上，"},{"start":12.39,"end":16.43,"text":"你就有机会看到日全食。"},{"start":16.45,"end":20.73,"text":"你需要一副日食眼镜或其他间接观看的方法"},{"start":20.75,"end":24.5,"text":"你需要一副日食眼镜，才能安全地观察太阳。"},{"start":24.52,"end":32.32,"text":"天气晴朗的话，你可以看到这些："},{"start":32.32,"end":38.46,"text":"偏食：太阳的圆面被月亮挡住一部分，可能持续一个多小时。"},{"start":38.46,"end":44.22,"text":"钻石环：阳光穿过月球上的山谷，形成一道明亮的闪光"},{"start":44.24,"end":48.14,"text":"表示全食前的最后几秒"},{"start":48.14,"end":54.7,"text":"贝利珠：只有月球边缘的低谷还能透出阳光"},{"start":54.7,"end":59.32,"text":"全食：月亮盖住整个太阳圆面，只有在全食带内才看得到。在别的地方不要摘眼镜。"},{"start":59.35,"end":63.1,"text":"在有些地方可能不到一分钟"},{"start":63.12,"end":68.34,"text":"最后阶段：月牙开始从月亮后面探出来。不要再直视太阳"}],"de":[],"en":[{"start":2.99,"end":8.23,"text":"How to safely watch a total solar eclipse","words":[["How","怎样"],["to","去"],["safely","安全地"],["watch","观看"],["a","一次"],["total","全"],["solar","日"],["eclipse","食"]]},{"start":8.25,"end":12.37,"text":"If you're in the path of totality,","words":[["If","如果"],["you're","你"],["in","在"],["the","这"],["path","路径"],["of","的"],["totality,","全食"]]},{"start":12.39,"end":16.43,"text":"you'll have a chance to watch a total solar eclipse.","words":[["you'll","你将"],["have","有"],["a","一个"],["chance","机会"],["to","去"],["watch","观看"],["a","一次"],["total","全"],["solar","日"],["eclipse.","食"]]},{"start":16.45,"end":20.73,"text":"You'll need a pair of eclipse glasses or other indirect viewing method","words":[["You'll","你将"],["need","需要"],["a","一"],["pair","副"],["of","的"],["eclipse","日食"],["glasses","眼镜"],["or","或"],["other","其他"],["indirect","间接"],["viewing","观看"],["method","方法"]]},{"start":20.75,"end":24.5,"text":"You'll need a pair of eclipse glasses to safely observe the sun.","words":[["You'll","你将"],["need","需要"],["a","一"],["pair","副"],["of","的"],["eclipse","日食"],["glasses","眼镜"],["to","去"],["safely","安全地"],["observe","观察"],["the","这"],["sun.","太阳"]]},{"start":24.52,"end":32.32,"text":"Here's what you can expect to see if the sky is clear:","words":[["Here's","这是"],["what","什么"],["you","你"],["can","能"],["expect","期待"],["to","去"],["see","看到"],["if","如果"],["the","这"],["sky","天空"],["is","是"],["clear:","晴朗"]]},{"start":32.32,"end":38.46,"text":"Partial Eclipse: Sun's disk partially blocked by moon. Can last over an hour.","words":[["Partial","偏"],["Eclipse:","食"],["Sun's","太阳的"],["disk","圆面"],["partially","部分"],["blocked","挡住"],["by","被"],["moon.","月亮"],["Can","能"],["last","持续"],["over","超过"],["an","一个"],["hour.","小时"]]},{"start":38.46,"end":44.22,"text":"Diamond Ring: Sunlight streaming through the moon's valleys creates single bright flash of light","words":[["Diamond","钻石"],["Ring:","环"],["Sunlight","阳光"],["streaming","流"],["through","穿过"],["the","这"],["moon's","月亮的"],["valleys","山谷"],["creates","形成"],["single","单个"],["bright","明亮"],["flash","闪"],["of","的"],["light","光"]]},{"start":44.24,"end":48.14,"text":"Marks the last few seconds before totality","words":[["Marks","标志"],["the","这"],["last","最后"],["few","几"],["seconds","秒"],["before","在…前"],["totality","全食"]]},{"start":48.14,"end":54.7,"text":"Baily's Beads: Only low-lying valleys on the moon's edge allow sunlight through","words":[["Baily's","贝利"],["Beads:","珠"],["Only","只有"],["low-lying","低洼的"],["valleys","山谷"],["on","在"],["the","这"],["moon's","月亮的"],["edge","边缘"],["allow","允许"],["sunlight","阳光"],["through","透过"]]},{"start":54.7,"end":59.32,"text":"Totality: Moon covers the entire disk of the sun. Only visible within the path of totality. Don't take your glasses off elsewhere.","words":[["Totality:","全食"],["Moon","月亮"],["covers","盖住"],["the","这"],["entire","整个"],["disk","圆面"],["of","的"],["the","这"],["sun.","太阳"],["Only","只"],["visible","可见"],["within","在…内"],["the","这"],["path","路径"],["of","的"],["totality.","全食"],["Don't","不要"],["take","摘"],["your","你的"],["glasses","眼镜"],["off","下"],["elsewhere.","在别处"]]},{"start":59.35,"end":63.1,"text":"May last under a minute in some locations","words":[["May","可能"],["last","持续"],["under","不到"],["a","一"],["minute","分钟"],["in","在"],["some","一些"],["locations","地点"]]},{"start":63.12,"end":68.34,"text":"Final Stages: Crescent begins to peek out from behind the moon. Stop looking directly at the sun","words":[["Final","最后"],["Stages:","阶段"],["Crescent","月牙"],["begins","开始"],["to","去"],["peek","探"],["out","出"],["from","从"],["behind","后面"],["the","这"],["moon.","月亮"],["Stop","停止"],["looking","看"],["directly","直接"],["at","在"],["the","这"],["sun","太阳"]]}]}